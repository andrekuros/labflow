# Banco de dados (dev: SQLite; prod: troque para PostgreSQL + pgvector)
DATABASE_URL="file:./dev.db"

# Segredo para assinar sessoes JWT (gere um valor aleatorio longo em producao)
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-bem-longo"

# Camada de IA (opcional). Sem chave, o sistema usa embeddings locais e respostas heuristicas.
# Provedores suportados: "openai" | "ollama" | "none"
AI_PROVIDER="none"
AI_API_KEY=""
AI_BASE_URL=""
AI_CHAT_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
