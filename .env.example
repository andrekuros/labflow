# =============================================================================
# LabFlow — Variaveis de ambiente
# =============================================================================
#
# COMO CRIAR O ARQUIVO .env
#
#   Windows (PowerShell, na raiz do projeto):
#     Copy-Item .env.example .env
#
#   Linux / macOS:
#     cp .env.example .env
#
#   Depois edite .env com um editor de texto e ajuste os valores abaixo.
#   NUNCA commite o arquivo .env no Git (ele ja esta no .gitignore).
#
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Desenvolvimento (padrao): SQLite — nao precisa instalar servidor de banco.
# O arquivo sera criado em prisma/dev.db ao rodar npm run setup.
DATABASE_URL="file:./dev.db"

# Producao (PostgreSQL + pgvector):
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/labflow?schema=public"
# Requer alterar provider em prisma/schema.prisma para "postgresql".

# -----------------------------------------------------------------------------
# Autenticacao (OBRIGATORIO em producao)
# -----------------------------------------------------------------------------
# Segredo para assinar cookies de sessao (JWT). Deve ser longo e aleatorio.
# Gere um valor seguro, por exemplo:
#   Windows:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   Linux:    openssl rand -base64 48
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-bem-longo"

# -----------------------------------------------------------------------------
# Camada de IA (OPCIONAL)
# -----------------------------------------------------------------------------
# Sem configuracao, o LabFlow funciona 100% offline:
#   - busca semantica com embeddings locais
#   - assistente com respostas extrativas baseadas no RAG
#
# Provedores suportados:
#   none    — modo offline (padrao, sem custo)
#   openai  — OpenAI ou API compativel (Azure, Groq, etc.)
#   ollama  — LLM local via Ollama (http://localhost:11434)
AI_PROVIDER="none"

# Chave de API (obrigatoria se AI_PROVIDER=openai)
AI_API_KEY=""

# URL base da API (opcional; deixe vazio para usar o padrao do provedor)
# OpenAI padrao: https://api.openai.com/v1
# Ollama padrao: http://localhost:11434
AI_BASE_URL=""

# Modelo de chat (OpenAI: gpt-4o-mini, gpt-4o | Ollama: llama3, mistral, etc.)
AI_CHAT_MODEL="gpt-4o-mini"

# Modelo de embeddings (OpenAI: text-embedding-3-small)
AI_EMBEDDING_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Ambiente Node (opcional)
# -----------------------------------------------------------------------------
# NODE_ENV="production"
